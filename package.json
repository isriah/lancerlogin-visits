{
  "name": "lancerlogin-module-visits",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Guest Visits for LancerLogin Modular: guest team visit availability, booking, confirmations and weekly summaries.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" && node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "verify:core": "node scripts/verify-with-core.mjs --core"
  },
  "lancerlogin": {
    "moduleId": "visits",
    "contract": 1,
    "core": ">=2.0.0-beta.15 <3.0.0",
    "tablePrefix": "visits_",
    "entries": {
      "manifest": "./src/manifest.ts",
      "api": "./src/api.ts",
      "dashboard": "./src/dashboard.tsx"
    },
    "migrations": "./migrations",
    "adoptedCoreMigrations": []
  },
  "peerDependencies": {
    "@lancerlogin/module-sdk": "^1.1.0",
    "react": "^19.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
